{
  // يشير إلى الموقع المنشور حالياً في حسابك (zajel-sales-trial) وقاعدته zajel-trial.
  "name": "zajel-sales-trial",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "zajel-trial", "database_id": "df64f204-cc57-40b6-ab19-f7583f1afb27", "migrations_dir": "migrations" }
  ]
  // بعد تفعيل R2 في حسابك وإنشاء الـ bucket (npx wrangler r2 bucket create zajel-files)،
  // أضف هذا السطر بعد d1_databases (مع فاصلة) وانشر، فتعمل الملفات ومكتبة المعرفة:
  // "r2_buckets": [ { "binding": "FILES", "bucket_name": "zajel-files" } ]
}
