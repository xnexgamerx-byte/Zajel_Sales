{
  "name": "zajel-sales",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "zajel", "database_id": "REPLACE_WITH_REAL_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [ { "binding": "FILES", "bucket_name": "zajel-files" } ]
}
